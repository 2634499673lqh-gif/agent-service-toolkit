# TaskPilot local environment template
# Copy this file to .env for local use. Never commit .env or put real credentials here.

# Model/provider configuration (set USE_FAKE_MODEL=true for deterministic local checks)
USE_FAKE_MODEL=false
DEFAULT_MODEL=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GROQ_API_KEY=
OPENROUTER_API_KEY=
USE_AWS_BEDROCK=false
OLLAMA_MODEL=
OLLAMA_BASE_URL=

# OpenAI-compatible provider (set all three values when using this provider)
COMPATIBLE_MODEL=
COMPATIBLE_API_KEY=
COMPATIBLE_BASE_URL=

# Azure OpenAI (required together with the Azure provider)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview
# JSON object mapping the model names gpt-5 and gpt-5-mini to deployment IDs.
AZURE_OPENAI_DEPLOYMENT_MAP=

# Web server configuration
MODE=
HOST=0.0.0.0
PORT=8080
GRACEFUL_SHUTDOWN_TIMEOUT=30
LOG_LEVEL=WARNING

# Authentication. When set, router endpoints require Authorization: Bearer <AUTH_SECRET>.
# Leave empty only for local development; never place a real token in this template.
AUTH_SECRET=

# LangChain tracing (optional)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=default
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=

# Langfuse tracing (optional)
LANGFUSE_TRACING=false
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Database configuration. Local default is SQLite; Docker Compose overrides the API service to PostgreSQL.
DATABASE_TYPE=sqlite
SQLITE_DB_PATH=checkpoints.db

# TaskPilot business persistence (optional for local LangGraph-only development; PostgreSQL only)
TASKPILOT_DATABASE_URL=

# PostgreSQL (required when DATABASE_TYPE=postgres; Compose supplies safe local defaults)
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_APPLICATION_NAME=agent-service-toolkit
POSTGRES_MIN_CONNECTIONS_PER_POOL=1
POSTGRES_MAX_CONNECTIONS_PER_POOL=1

# MongoDB (required fields depend on the selected deployment; see docker/compose.mongo.yaml)
MONGO_HOST=
MONGO_PORT=
MONGO_DB=
MONGO_USER=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=
MONGO_TLS=false

# Optional upstream integrations
OPENWEATHERMAP_API_KEY=
AWS_KB_ID=
GITHUB_PAT=
MCP_GITHUB_SERVER_URL=https://api.githubcopilot.com/mcp/

# Voice features are configured by the Streamlit client (optional).
VOICE_STT_PROVIDER=
VOICE_TTS_PROVIDER=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# Streamlit client URL. If empty, the client derives http://{HOST}:{PORT}.
AGENT_URL=
