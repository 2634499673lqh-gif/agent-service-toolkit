FROM python:3.13.14-slim

WORKDIR /app

ENV UV_PROJECT_ENVIRONMENT="/usr/local/"
ENV UV_COMPILE_BYTECODE=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends libexpat1 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml .
COPY uv.lock .
RUN pip install --no-cache-dir uv==0.12.5
RUN uv sync --frozen --no-install-project --no-dev

COPY src/agents/ ./agents/
COPY src/core/ ./core/
COPY src/geochange/ ./geochange/
COPY data/geochange-aoi/ ./data/geochange-aoi/
COPY data/geochange-fixtures/ ./data/geochange-fixtures/
COPY src/memory/ ./memory/
COPY src/persistence/ ./persistence/
COPY src/runtime/ ./runtime/
COPY src/schema/ ./schema/
COPY src/service/ ./service/
COPY src/run_service.py .
COPY scripts/ ./scripts/
COPY alembic.ini .
COPY migrations/ ./migrations/

CMD ["python", "run_service.py"]
